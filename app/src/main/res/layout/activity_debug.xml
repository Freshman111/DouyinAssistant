<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="调试设置"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <CheckBox
        android:id="@+id/cb_save_audio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="保存音频文件"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <CheckBox
        android:id="@+id/cb_save_logs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="保留应用日志"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <CheckBox
        android:id="@+id/cb_voice_recognition_source"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="使用语音识别录音源（B）"
        android:textSize="16sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="不勾选为通话录音源（A）。切换后请关闭并重新开启语音。"
        android:textSize="12sp"/>

    <LinearLayout
        android:id="@+id/voice_experiment_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_enroll_voice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="录入我的声音" />

        <TextView
            android:id="@+id/tv_voice_sample"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未录入声样" />

        <CheckBox
            android:id="@+id/cb_voice_experiment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="语音实验（录音对照）" />

        <CheckBox
            android:id="@+id/cb_voice_experiment_on_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="同时在手机上运行新模型（测速）" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="实验使用 B 录音源，保存 PCM 和日志，不执行滑动。切换后请重新开启语音。"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_permission_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="权限状态"
        android:textSize="14sp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btn_request_permission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="请求权限"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="音频保存和日志保留可分别开启。应用日志保存在 files/logs 目录。"
        android:textSize="12sp"
        android:textColor="#666666"/>

</LinearLayout>
</ScrollView>
